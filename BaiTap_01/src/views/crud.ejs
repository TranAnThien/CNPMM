<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Thêm Người Dùng</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <style>
        body { background-color: #f4f7f6; padding-top: 50px; pb-5; }
        .container-form { max-width: 800px; margin: 0 auto; background: white; padding: 40px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); }
        .form-control { border-radius: 6px; }
    </style>
</head>
<body>
    <div class="container container-form mb-5">
        <h3 class="text-center text-success font-weight-bold mb-4">THÊM NGƯỜI DÙNG MỚI</h3>
        <hr class="mb-4">

        <form action="/post-crud" method="post">
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label class="font-weight-bold text-muted">Email</label>
                    <input type="email" class="form-control" name="email" placeholder="example@gmail.com" required>
                </div>
                <div class="form-group col-md-6">
                    <label class="font-weight-bold text-muted">Password</label>
                    <input type="password" class="form-control" name="password" placeholder="Nhập mật khẩu" required>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label class="font-weight-bold text-muted">First Name</label>
                    <input type="text" class="form-control" name="firstName" placeholder="Nhập họ">
                </div>
                <div class="form-group col-md-6">
                    <label class="font-weight-bold text-muted">Last Name</label>
                    <input type="text" class="form-control" name="lastName" placeholder="Nhập tên">
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-4">
                    <label class="font-weight-bold text-muted">Phone Number</label>
                    <input type="text" class="form-control" name="phoneNumber" placeholder="Số điện thoại">
                </div>
                <div class="form-group col-md-4">
                    <label class="font-weight-bold text-muted">Gender</label>
                    <select name="gender" class="form-control">
                        <option value="0">Nam (Male)</option>
                        <option value="1">Nữ (Female)</option>
                    </select>
                </div>
                <div class="form-group col-md-4">
                    <label class="font-weight-bold text-muted">Role</label>
                    <select name="roleId" class="form-control">
                        <option value="1">Quản trị viên (Admin)</option>
                        <option value="2">Bác sĩ (Doctor)</option>
                        <option value="3">Bệnh nhân (Patient)</option>
                    </select>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-5">
                <a href="/get-crud" class="btn btn-outline-secondary font-weight-bold">📋 Xem Danh Sách</a>
                <button type="submit" class="btn btn-success font-weight-bold px-5">+ TẠO MỚI</button>
            </div>
        </form>
    </div>
</body>
</html>