<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Cập Nhật Người Dùng</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <style>
        body { background-color: #f4f7f6; padding-top: 50px; }
        .container-form {
            max-width: 650px;
            margin: 0 auto;
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }
    </style>
</head>
<body>
    <div class="container container-form">
        <h3 class="text-center text-primary font-weight-bold mb-4">CẬP NHẬT THÔNG TIN</h3>
        <hr class="mb-4">

        <form action="/put-crud" method="post">
            <!-- ID bị ẩn đi nhưng vẫn gửi về server -->
            <input type="hidden" name="id" value="<%=data.id%>">

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label class="font-weight-bold text-muted">Họ (First Name)</label>
                    <input type="text" class="form-control form-control-lg" name="firstName" value="<%=data.firstName%>">
                </div>
                <div class="form-group col-md-6">
                    <label class="font-weight-bold text-muted">Tên (Last Name)</label>
                    <input type="text" class="form-control form-control-lg" name="lastName" value="<%=data.lastName%>">
                </div>
            </div>

            <div class="form-group">
                <label class="font-weight-bold text-muted">Địa Chỉ Hiện Tại</label>
                <input type="text" class="form-control form-control-lg" name="address" value="<%=data.address%>">
            </div>

            <div class="d-flex justify-content-between mt-5">
                <a href="/get-crud" class="btn btn-light font-weight-bold border">⬅ Quay Lại</a>
                <button type="submit" class="btn btn-primary font-weight-bold px-5">💾 LƯU THAY ĐỔI</button>
            </div>
        </form>
    </div>
</body>
</html>